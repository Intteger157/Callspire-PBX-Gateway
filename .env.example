# Optional environment overrides for Callspire PBX Gateway (local dev / systemd).
# Copy to .env and adjust. Do not commit .env with real secrets.
#
# Main gateway settings live in config.yaml — copy from config.example.yaml first.

# Path to config.yaml (optional; default: ./config.yaml)
# PBX_GATEWAY_CONFIG=/etc/callspire/config.yaml

# Web softphone mount (gateway-web-softphone)
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
SESSION_NAME=callspire_softphone_sid
SESSION_SECURE=false
SOFTPHONE_STATIC_DIR=/path/to/callspire-web-softphone/softphone-web/dist
PBX_GATEWAY_SERVICE_TOKEN=
TRUST_PROXY=false

# Fallback WebRTC settings if not configured in gateway admin UI
WEBRTC_SIP_WS_URL=
WEBRTC_SIP_HOST=
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=

WEB_SOFTPHONE_ENABLED=1
WEB_SOFTPHONE_SKIP_ROOT_REDIRECT=0
